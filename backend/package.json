{
  "name": "bdu-store-backend",
  "version": "1.0.0",
  "description": "BDU Store — campus device storage API (NestJS + Prisma + PostgreSQL). University-ID authentication only; no email anywhere.",
  "author": "BDU Store Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config test/jest-e2e.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma generate && ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.9.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "argon2": "^0.30.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.9.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.9.0": true,
    "@prisma/engines@6.9.0": true,
    "argon2@0.30.3": true,
    "prisma@6.9.0": true
  }
}
