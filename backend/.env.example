# Copy to .env and adjust for your machine.
# Start a PostgreSQL instance, e.g.:
#   docker run -d --name bdu-store-postgres \
#     -e POSTGRES_USER=bdu -e POSTGRES_PASSWORD=bdu_store_dev_pw -e POSTGRES_DB=bdu_store \
#     -p 127.0.0.1:5542:5432 -v bdu-store-pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL="postgresql://bdu:bdu_store_dev_pw@127.0.0.1:5542/bdu_store?schema=public"
TEST_DATABASE_URL="postgresql://bdu:bdu_store_dev_pw@127.0.0.1:5542/bdu_store_test?schema=public"
# Generate one with: openssl rand -hex 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION="7d"
APP_PORT=4000
CLIENT_URL="http://localhost:3000"
NODE_ENV=development
